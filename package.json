{
  "name": "@local/dsh-poster-studio",
  "version": "1.1.0",
  "author": "Oyang",
  "description": "自然语言驱动的浮动海报设计面板：任意会话里说句话即可改标题、换背景、调色、删层、导出 PNG；面板内也可可视化编辑（官网着色器背景、中英文字体、图层系统、配色库、版本历史）。作者：Oyang",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "NOTICE"
  ],
  "scripts": {
    "build": "node build.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
